#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* intToRoman(int num) {
    // Array of values mapped to their Roman numeral counterparts in descending order
    int values[] = {1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1};
    char* symbols[] = {"M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"};
    
    // Allocate space for the result string. Max possible length for 1-3999 is 15 chars ("MMMCMXCVIII") + 1 null terminator
    char* roman = (char*)malloc(16 * sizeof(char));
    roman[0] = '\0'; // Initialize to empty string
    
    // Loop through the values array
    for (int i = 0; i < 13; i++) {
        // While the current value can be subtracted from num
        while (num >= values[i]) {
            strcat(roman, symbols[i]); // Append the symbol
            num -= values[i];          // Subtract the value
        }
    }
    
    return roman;
}
