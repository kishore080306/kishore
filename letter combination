#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Keypad mapping where index represents the digit (0 and 1 are empty)
const char* phoneMap[] = {
    "",     "",     "abc",  "def", 
    "ghi",  "jkl",  "mno",  "pqrs", 
    "tuv",  "wxyz"
};

// Backtracking helper function
void backtrack(const char* digits, int index, char* current, char** result, int* returnSize) {
    // Base case: if we reached the end of the digit string
    if (digits[index] == '\0') {
        result[*returnSize] = strdup(current); // Allocate and copy current string
        (*returnSize)++;
        return;
    }
    
    int digit = digits[index] - '0';
    const char* letters = phoneMap[digit];
    
    // Loop through all letters mapped to the current digit
    for (int i = 0; letters[i] != '\0'; i++) {
        current[index] = letters[i]; // Place the letter
        current[index + 1] = '\0';   // Maintain null-termination
        
        backtrack(digits, index + 1, current, result, returnSize);
    }
}

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
char** letterCombinations(char* digits, int* returnSize) {
    *returnSize = 0;
    
    // Edge case: if the input string is empty
    if (digits == NULL || digits[0] == '\0') {
        return NULL;
    }
    
    int len = strlen(digits);
    
    // Calculate maximum possible combinations to safely allocate memory
    // Max combinations = 4^4 = 256
    int maxCombinations = 1;
    for (int i = 0; i < len; i++) {
        int digit = digits[i] - '0';
        if (digit == 7 || digit == 9) {
            maxCombinations *= 4;
        } else {
            maxCombinations *= 3;
        }
    }
    
    // Allocate array of string pointers
    char** result = (char**)malloc(maxCombinations * sizeof(char*));
    
    // Temporary buffer to hold the current combination path (+1 for '\0')
    char* current = (char*)calloc(len + 1, sizeof(char));
    
    // Start backtracking from index 0
    backtrack(digits, 0, current, result, returnSize);
    
    free(current); // Free the temporary path buffer
    return result;
}
