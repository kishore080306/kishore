# Step 1: Read n and m (though they aren't strictly needed for the logic)
n, m = map(int, input().split())

# Step 2: Read the initial array
array = list(map(int, input().split()))

# Step 3: Read sets A and B
# We convert them to sets immediately for O(1) lookup speed
set_a = set(map(int, input().split()))
set_b = set(map(int, input().split()))

# Step 4: Initialize happiness
happiness = 0

# Step 5: Iterate through the array and update happiness
for num in array:
    if num in set_a:
        happiness += 1
    elif num in set_b:
        happiness -= 1

# Step 6: Output the final result
print(happiness)
