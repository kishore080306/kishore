#include <stdio.h>
#include <string.h>

// Helper function to map Roman characters to their integer values
int getRomanValue(char c) {
    switch (c) {
        case 'I': return 1;
        case 'V': return 5;
        case 'X': return 10;
        case 'L': return 50;
        case 'C': return 100;
        case 'D': return 500;
        case 'M': return 1000;
        default:  return 0;
    }
}

int romanToInt(char* s) {
    int total = 0;
    int length = strlen(s);
    
    for (int i = 0; i < length; i++) {
        int current_val = getRomanValue(s[i]);
        
        // If there's a next character and its value is greater than the current one,
        // subtract the current value (subtractive rule).
        if (i + 1 < length && current_val < getRomanValue(s[i + 1])) {
            total -= current_val;
        } else {
            // Otherwise, add the current value.
            total += current_val;
        }
    }
    
    return total;
}
